+                    try p.hello([Purpose.drop, .pair, .verify, .resume, .retire][i / 10 % 5], paired: i % 20 < 10)
+                    try p.message(type, body)
+                    try p.message(type, body, more: 1, total: UInt32.random(in: 0...UInt32.max, using: &rng))
+                case 7:
