+                    for _ in 0..<20 { try p.plain(Data([FrameType.hello.rawValue, 1])) }
+                    try p.plain(Data([type, 1]) + Crypto.random(100))
+                    try p.plain(Data([FrameType.hello.rawValue, 0]) + Crypto.random(5000))
+                case 6:
