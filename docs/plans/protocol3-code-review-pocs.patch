+    /// F1. P11/P13: "anyone else ... cannot end the drop"; "every connection is held to the
+    /// budget of its class". The budget of the stranger class is one global pool: whoever fills
+    /// it keeps everyone else out, paired Macs included.
+    func testPoC_F1_SilentConnectionsDoNotKeepAPairedMacOut() throws {
+        let (sender, receiver) = try pairedMacs()
