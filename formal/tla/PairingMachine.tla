--------------------------- MODULE PairingMachine ---------------------------
(***************************************************************************)
(* The pairing transaction at ONE Mac, as a state machine.                 *)
(*                                                                         *)
(* This is Sources/NimbusCrypto/PairingMachine.swift written as a          *)
(* specification: Step(s, e) is PairingMachine.step. It is not a sketch of *)
(* that code; the two are held equal. PairingMachineTests walks every      *)
(* state the Swift machine can reach under every event and writes the      *)
(* transition relation to PairingImpl.tla, and PairingRefinement.tla has   *)
(* TLC check that relation against Step, both ways.                        *)
(*                                                                         *)
(* What is abstracted: the values. A commitment, a nonce and a reveal are  *)
(* 32 bytes in the code; here an arriving one is "good", "damaged" (wrong  *)
(* length) or "malformed" (unreadable), and a reveal may also be "wrong"   *)
(* (it does not open the commitment). What a person types is right or      *)
(* wrong. Whether the right value can be FORGED is not this model's        *)
(* question (formal/tamarin/NimbusPairing.spthy asks that); this one asks  *)
(* what the machine does with every sequence of events whatever, which is  *)
(* to say against an other end that keeps to nothing.                      *)
(*                                                                         *)
(* Run: see formal/README.md, or ./build.sh verify                         *)
(*                                                                         *)
(*                                                                         *)
(* THE ABSTRACTION CONTRACT                                                *)
(*                                                                         *)
(* "The Swift code is Step" is a statement about three functions, from     *)
(* what the code has to what this file has. They are written here, and a   *)
(* second time in PairingMachineTests (Abstract, Transcript.label, name),  *)
(* which is what the tests hold the code to.                               *)
(*                                                                         *)
(* 1. STATES. For a Swift machine m:                                       *)
(*                                                                         *)
(*      abs(m) = [role     |-> m.control.role,                             *)
(*                byNumber |-> m.control.byNumber,                         *)
(*                phase    |-> m.control.phase,                            *)
(*                tries    |-> m.control.triesLeft,                        *)
(*                local    |-> m.control.localRight,                       *)
(*                remote   |-> m.control.remoteRight]                      *)
(*                                                                         *)
(* 2. EVENTS. For a Swift event e arriving at m, abs(m, e). It looks at m  *)
(*    only for two values m has kept (a commitment, a code to expect):     *)
(*                                                                         *)
(*      .begin                 "begin"                                     *)
(*      .timeout               "timeout"                                   *)
(*      .received(.commit, v)  v unreadable (nil):  "commitMalformed"      *)
(*                             v is not 32 bytes:   "commitDamaged"        *)
(*                             otherwise:           "commit"               *)
(*      .received(.nonce, v)   the same three, "nonce..."                  *)
(*      .received(.reveal, v)  nil: "revealMalformed"; not 32 bytes:       *)
(*                             "revealDamaged"; 32 bytes, m has kept a     *)
(*                             commitment C, and C is                      *)
(*                               SHA-256("nimbus-drop pair commit v1"      *)
(*                                       || h || v):                       *)
(*                             "reveal"; 32 bytes otherwise (also when m   *)
(*                             has kept no commitment): "revealWrong"      *)
(*      .typed(d)              the codes exist at m and the bytes of d     *)
(*                             (UTF-8) are the bytes of the code m         *)
(*                             expects: "typedRight"; otherwise (also      *)
(*                             when no code exists yet): "typedWrong".     *)
(*                             Bytes: a right code with a space in it is   *)
(*                             wrong here. PairingSession.submit strips    *)
(*                             what is not a digit before the machine      *)
(*                             sees an entry.                              *)
(*      .received(.paired, v)  "paired", whatever v is; likewise           *)
(*                             "failed" and "other"                        *)
(*                                                                         *)
(*    Two of this file's events therefore have NO Swift event in some      *)
(*    states: no entry is right where no code exists (phase idle,          *)
(*    awaitCommit, awaitNonce, awaitReveal), and no reveal opens a         *)
(*    commitment where none was kept (every state but a responder's, by    *)
(*    codes, from awaitReveal on). Step has rows for them all the same.    *)
(*    In each such state its row for "typedRight" is its row for           *)
(*    "typedWrong", and its row for "reveal" is its row for "revealWrong"  *)
(*    (checked, state by state, by PairingMachineTests), so those rows     *)
(*    say nothing that no machine does; PairingImpl.tla writes them from   *)
(*    the event that can be made.                                          *)
(*                                                                         *)
(* 3. EFFECTS. abs(effect) is its name: .send(x, value: _) is "send x",    *)
(*    .codes(mine: _, triesLeft: _) is "codes", .fail(w) is "fail w";      *)
(*    .confirming, .otherTyped and .store are themselves. What an effect   *)
(*    CARRIES is not in this file at all. It is the second obligation      *)
(*    below.                                                               *)
(*                                                                         *)
(* EVERY STORED PROPERTY of PairingMachine, and what this file sees of it  *)
(* (testTheContractAccountsForEveryStoredProperty fails when the struct    *)
(* has a property with no line here):                                      *)
(*                                                                         *)
(*   control       holds the six that follow and nothing else              *)
(*   role          IN THE STATE. Never changes.                            *)
(*   byNumber      IN THE STATE. Never changes.                            *)
(*   phase         IN THE STATE.                                           *)
(*   triesLeft     IN THE STATE (tries).                                   *)
(*   localRight    IN THE STATE (local).                                   *)
(*   remoteRight   IN THE STATE (remote).                                  *)
(*   h             ABSTRACTED AWAY. The handshake hash. Never changes.     *)
(*                 Read by classify (does this reveal open the             *)
(*                 commitment) and by effect(of:) (the commitment sent,    *)
(*                 the codes). Safe: what classify does with it IS the     *)
(*                 definition of "reveal" against "revealWrong" above,     *)
(*                 and Control, which decides, has no h to read.           *)
(*   theirNumber   ABSTRACTED AWAY. Never changes. By identity number it   *)
(*                 becomes `expected`; otherwise it is not read.           *)
(*   ns            ABSTRACTED AWAY. Written once: an initiator's own       *)
(*                 value, in the step that says "send commit"; at a        *)
(*                 responder, the reveal, in the step that takes it.       *)
(*                 Read by effect(of:) only (the commitment, the reveal,   *)
(*                 the codes). No decision reads it.                       *)
(*   nr            ABSTRACTED AWAY. Written once: a responder's own        *)
(*                 value, in the step that says "send nonce"; at an        *)
(*                 initiator, the value that arrived, in the step that     *)
(*                 takes it. Read by effect(of:) only.                     *)
(*   commit        ABSTRACTED AWAY. Written once, at a responder: the      *)
(*                 commitment, in the step that takes it. Read by          *)
(*                 classify only, for the one comparison of function 2.    *)
(*   expected      ABSTRACTED AWAY. None until the step that first says    *)
(*                 "codes"; then theirNumber, or the code the other Mac    *)
(*                 shows; never changed after. Read by classify only,      *)
(*                 for the other comparison of function 2. Whether there   *)
(*                 is one is not always in the state either ("failed"      *)
(*                 does not say whether the codes were ever up); safe,     *)
(*                 because in a final state nothing is decided.            *)
(*   mine          DETERMINED by the history, not by the state: empty      *)
(*                 until the step that first says "codes", then this       *)
(*                 Mac's code (empty by identity number), never changed    *)
(*                 after. Read by nothing that decides or classifies:      *)
(*                 it is what is shown.                                    *)
(*                                                                         *)
(* THE TWO OBLIGATIONS                                                     *)
(*                                                                         *)
(* CONGRUENCE. For all machines m1, m2 that can be reached and all events  *)
(* e1, e2: if abs(m1) = abs(m2) and abs(m1, e1) = abs(m2, e2) then, with   *)
(* (m', effects) the result of m.step(e),                                  *)
(*                                                                         *)
(*      abs(m1') = abs(m2')   and   names(effects1) = names(effects2)      *)
(*                                                                         *)
(* and both are Step(abs(m1), abs(m1, e1)). It is what lets a relation     *)
(* written from ONE machine per state (PairingImpl.tla) speak for every    *)
(* machine in that state.                                                  *)
(*                                                                         *)
(* PAYLOADS. What each effect carries is this function of what went into   *)
(* the machine: h, theirNumber, the values it drew, the values it kept.    *)
(*                                                                         *)
(*      send commit   SHA-256("nimbus-drop pair commit v1" || h || Ns),    *)
(*                    Ns being the one value drawn, in that same step      *)
(*      send nonce    Nr, the one value drawn, in that same step, which    *)
(*                    is the step that keeps the commitment                *)
(*      send reveal   that Ns, and no other                                *)
(*      codes         triesLeft: the state's tries after the step.         *)
(*                    mine: empty by identity number. Otherwise, with      *)
(*                    (R, S) the two six-digit codes of                    *)
(*                      KDF(Ns || Nr,                                      *)
(*                          "nimbus-drop pair codes v1" || h, 16),         *)
(*                    S at an initiator and R at a responder; and the      *)
(*                    code EXPECTED (which is not carried: it is what      *)
(*                    makes an entry right) is the other of the two, or    *)
(*                    theirNumber. Neither changes once it exists.         *)
(*      send paired, send failed     carry nothing                         *)
(*      a value is drawn from the random source in the two steps named     *)
(*                    above and in no other, one in a transaction          *)
(*      store         once at most, in the step that enters "paired"       *)
(*                                                                         *)
(* WHAT ESTABLISHES EACH PART (three different strengths; none is a        *)
(* proof that the Swift refines this file for every input)                 *)
(*                                                                         *)
(* ENUMERATED, and complete for what it covers:                            *)
(*   - Control.step, the Swift function that decides, at every state it    *)
(*     reaches (99) under every kind of event (17), is the relation in     *)
(*     PairingImpl.tla row for row                                         *)
(*     (testWhatIsDecidedIsDecidedWithNoValueInSight);                     *)
(*   - that relation is Step, both ways (PairingRefinement.tla, by TLC);   *)
(*   - the relation as written from whole machines, one per state:         *)
(*     1,683 steps, the payloads checked at each.                          *)
(*                                                                         *)
(* ARGUED, from the shape of the code, with no bound and no tool:          *)
(*   - PairingMachine.step is three things in a row.                       *)
(*     kind = classify(event); decisions = control.step(kind); then one    *)
(*     effect for each decision but `keep`, of the same name               *)
(*     (effect(of:)).                                                      *)
(*   - Control is a struct of the six fields of the state. Its step is     *)
(*     handed the kind and nothing else, and it calls nothing and names    *)
(*     nothing outside itself (forty lines: a switch over its own fields   *)
(*     and the kind). So nothing it decides can depend on a hash, a        *)
(*     value, a code or a number: none is in its reach. That much is       *)
(*     held by the compiler, not by a test.                                *)
(*   - Control's fields can be set only inside Control (private(set)),     *)
(*     and control.step is called in that one place. classify is not       *)
(*     `mutating`: it changes nothing.                                     *)
(*   So abs(m') and the names of the effects are a function of abs(m)      *)
(*   and classify(m, e), for every machine and every event; and            *)
(*   CONGRUENCE holds wherever classify(m, e) = abs(m, e).                 *)
(*                                                                         *)
(* EXPLORED AT RANDOM, bounded, and no more is claimed than was run:       *)
(*   - classify(m, e) = abs(m, e); abs(m') and the names against the       *)
(*     relation; every payload against PAYLOADS                            *)
(*     (testEveryMachineInAStateDoesWhatTheRelationSaysOfThatState,        *)
(*     testEveryValueSentAndEveryCodeShownIsWhatTheProtocolSays). The      *)
(*     oracle is written from the protocol's description on CryptoKit's    *)
(*     SHA-256 and HMAC, and calls nothing of the machine or of            *)
(*     PairCodes.                                                          *)
(*   - An ordinary run: two fixed seeds and one from the clock; about      *)
(*     10,000 machines (at least 36 for each of the 99 states, by about    *)
(*     4,000 different histories); other hashes, values and numbers for    *)
(*     each; every one of 82 concrete forms of event at each (lengths 0,   *)
(*     1, 31, 32, 33, 64; a reveal that opens a commitment under another   *)
(*     hash; the right code with a space, a digit more, a digit changed,   *)
(*     in other scripts; this Mac's own code; an earlier entry again);     *)
(*     about 760,000 steps in about five seconds. Every (state, event)     *)
(*     pair is taken at least 36 times where every machine in the state    *)
(*     can be sent the event, and at least 8 times where only some can.    *)
(*     The test prints the figures of each run. NIMBUS_WALK_SEEDS=300      *)
(*     runs a hundred times as many: once, on 2026-11-24, 76.5 million     *)
(*     steps at 1.05 million machines (over 5,000 for each state) in       *)
(*     eight minutes, and nothing found.                                   *)
(*   - What that cannot find: a dependence that fewer than about one       *)
(*     machine in a thousand would meet, such as on one particular         *)
(*     32-byte value. Against that there is the reading of classify (a     *)
(*     dozen lines, three comparisons) and of effect(of:), and the         *)
(*     mutants: scripts/mutate.py has the payloads changed one at a time   *)
(*     and behaviour hidden behind a hash's first byte, behind one digit   *)
(*     on the last try, and behind a history; each must fail these tests.  *)
(*                                                                         *)
(* NOT IN THIS CONTRACT: that a commitment hides and binds, and that a     *)
(* code cannot be steered (formal/tamarin/NimbusPairing.spthy, with ideal  *)
(* cryptography; formal/sas-bound.py); that SHA-256 and HKDF are computed  *)
(* right (scripts/vectors.py).                                             *)
(*                                                                         *)
(* WHAT "store" CAUSES. The machine says "store" and no more;              *)
(* PairingSession.store does it (by reading, and held by                   *)
(* PairingTests.testWhatIsStoredIsTheKeyThisConnectionProved):             *)
(*                                                                         *)
(*      Trust.store(pairing: K, announced: N, method: M, remaining: R,     *)
(*                  replacing:, name:)                                     *)
(*                                                                         *)
(*   K   the static key that the Noise handshake of THIS connection        *)
(*       proved: Channel.remote of the channel whose handshake hash is     *)
(*       the machine's h. Not a key named by a tile, an address or a       *)
(*       Bonjour record; and theirNumber is K's identity number.           *)
(*   N   the name in that connection's sealed hello: a label.              *)
(*   M   "identity number" if byNumber, else "codes".                      *)
(*   R   the time that hello says the key has left.                        *)
(*   replacing, name: what this Mac's person chose.                        *)
(* Nothing is stored if the session has ended meanwhile (cancelled,        *)
(* refused, out of time).                                                  *)
(***************************************************************************)
EXTENDS Naturals, Sequences

Roles  == {"initiator", "responder"}
Phases == {"idle", "awaitCommit", "awaitNonce", "awaitReveal", "codes", "paired", "failed"}

\* Everything that can happen to the machine.
Received == {"commit", "commitDamaged", "commitMalformed",
             "nonce", "nonceDamaged", "nonceMalformed",
             "reveal", "revealDamaged", "revealMalformed", "revealWrong",
             "paired", "failed", "other"}
Events   == {"begin", "typedRight", "typedWrong", "timeout"} \cup Received

\* The kind of message an arrival is, and what state its value is in.
Kind(e) == CASE e \in {"commit", "commitDamaged", "commitMalformed"} -> "commit"
             [] e \in {"nonce", "nonceDamaged", "nonceMalformed"} -> "nonce"
             [] e \in {"reveal", "revealDamaged", "revealMalformed", "revealWrong"} -> "reveal"
             [] OTHER -> e
Malformed(e) == e \in {"commitMalformed", "nonceMalformed", "revealMalformed"}
Damaged(e)   == e \in {"commitDamaged", "nonceDamaged", "revealDamaged"}

States == [role: Roles, byNumber: BOOLEAN, phase: Phases, tries: 0..3, local: BOOLEAN, remote: BOOLEAN]

Start(role, byNumber) ==
    [role |-> role, byNumber |-> byNumber, phase |-> "idle", tries |-> 3, local |-> FALSE, remote |-> FALSE]

Final(s) == s.phase \in {"paired", "failed"}

Fail(s, why) == << [s EXCEPT !.phase = "failed"], << "fail " \o why >> >>

\* Both true: the pairing is stored. Otherwise the effects so far and no more.
Settle(s, effects) ==
    IF s.local /\ s.remote THEN << [s EXCEPT !.phase = "paired"], Append(effects, "store") >>
                           ELSE << s, effects >>

ShowCodes(s) == [s EXCEPT !.phase = "codes", !.tries = 3]

\* A value of the exchange: readable and 32 bytes, or the pairing ends.
BadValue(s, e) == IF Malformed(e) THEN Fail(s, "malformed") ELSE Fail(s, "damaged")

(***************************************************************************)
(* Step(s, e): the state after event e, and what the machine says to do.   *)
(***************************************************************************)
Step(s, e) ==
    IF Final(s) THEN << s, << >> >>
    ELSE IF e = "timeout" THEN Fail(s, "timedOut")
    ELSE IF e = "begin" THEN
        IF s.phase # "idle" THEN << s, << >> >>
        ELSE IF s.byNumber THEN << ShowCodes(s), << "codes" >> >>
        ELSE IF s.role = "responder" THEN << [s EXCEPT !.phase = "awaitCommit"], << >> >>
        ELSE << [s EXCEPT !.phase = "awaitNonce"], << "send commit" >> >>
    ELSE IF e = "typedRight" THEN
        IF s.phase # "codes" \/ s.local THEN << s, << >> >>
        ELSE Settle([s EXCEPT !.local = TRUE], << "confirming", "send paired" >>)
    ELSE IF e = "typedWrong" THEN
        IF s.phase # "codes" \/ s.local THEN << s, << >> >>
        ELSE IF s.tries = 1 THEN << [s EXCEPT !.tries = 0, !.phase = "failed"], << "send failed", "fail wrongCode" >> >>
        ELSE << [s EXCEPT !.tries = s.tries - 1], << "codes" >> >>
    ELSE \* a message from the other Mac
        IF s.phase = "awaitCommit" /\ Kind(e) = "commit" THEN
            IF e # "commit" THEN BadValue(s, e)
            ELSE << [s EXCEPT !.phase = "awaitReveal"], << "send nonce" >> >>
        ELSE IF s.phase = "awaitNonce" /\ Kind(e) = "nonce" THEN
            IF e # "nonce" THEN BadValue(s, e)
            ELSE << ShowCodes(s), << "send reveal", "codes" >> >>
        ELSE IF s.phase = "awaitReveal" /\ Kind(e) = "reveal" THEN
            IF Malformed(e) \/ Damaged(e) THEN BadValue(s, e)
            ELSE IF e = "revealWrong" THEN Fail(s, "didNotKeep")
            ELSE << ShowCodes(s), << "codes" >> >>
        ELSE IF s.phase = "codes" /\ e = "paired" THEN
            IF s.remote THEN Fail(s, "didNotKeep")
            ELSE Settle([s EXCEPT !.remote = TRUE], << "otherTyped" >>)
        ELSE IF s.phase = "codes" /\ e = "failed" THEN Fail(s, "theirsFailed")
        ELSE Fail(s, "didNotKeep")

=============================================================================
